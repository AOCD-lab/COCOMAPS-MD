# Copy the SMTP/URL lines below into your .env (which is gitignored) to enable
# the "results ready" email. Leave SMTP_HOST empty to disable notifications.

# SMTP server
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none (trusted internal relay only)
SMTP_SECURITY=starttls
SMTP_USER=no-reply@example.org
SMTP_PASSWORD=change-me
SMTP_FROM=COCOMAPS-MD <no-reply@example.org>

# Public base URL of the app, including the path prefix (no trailing slash).
# Used to build the link in the email: <URL>/analysis/<jobId>
COCOMAPS_PUBLIC_URL=https://example.org/BioTools/COCOMAPS-MD
